export DB_SCHEMA=public
# PostgreSQL
export DATABASE_URL="postgres://ravinier_owner:somesecretpassword@lemon.com:5432/ravinier?sslmode=disable&schema=${DB_SCHEMA}"

# S3 or S3 compatible storage credential
export S3_ENDPOINT=http://lemon.com:9000
export S3_ACCESS_KEY=ravinier
export S3_SECRET_KEY=somesecretpassword
export S3_BUCKET=ravinier

export DBMATE_MIGRATIONS_TABLE='migrations'
export DBMATE_MIGRATIONS_DIR='./migrations'
export DBMATE_NO_DUMP_SCHEMA=true